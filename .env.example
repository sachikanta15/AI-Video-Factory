# --- Depo ve defter ---
# STORE=fs → .data/assets (Docker gerekmez) · STORE=s3 → RustFS (yerel) / Cloudflare R2
STORE=fs
# LEDGER=jsonl → .data/ledger.jsonl · LEDGER=db → Postgres
LEDGER=jsonl
# fal'da endpoint'i henüz doğrulanmamış modelleri aç (Kling 3, Seedance 2)
FAL_ENABLE_UNVERIFIED=0

# --- Altyapı (docker compose ile yerelde) ---
DATABASE_URL=postgres://ys:ys@localhost:5433/youtube_studio
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=ys-assets
S3_ACCESS_KEY_ID=ysrustfs
S3_SECRET_ACCESS_KEY=ysrustfs-secret

# --- Bulut sağlayıcılar (boş bırakılanlar router'da devre dışı kalır) ---
FAL_KEY=
GEMINI_API_KEY=
# Set to 1 to use Vertex AI with Application Default Credentials instead of AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Minimum gap between Vertex generation request starts; increase if the project is burst-throttled.
GEMINI_VERTEX_MIN_INTERVAL_MS=1500
ELEVENLABS_API_KEY=

# Model kimlikleri sık değişiyor; burada ezilebilir.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_FAST_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Veo önizleme modelleri Gemini API'de 22 Eki 2026'da kapandı; kapanmış kimlik yazılırsa sağlayıcı kurulmaz.
# GEMINI_VEO_MODEL=
# Veo'nun yerine Gemini Omni Flash video (doğrulanmadı; ilk denemeyi elle yap): 1 ile açılır.
# GEMINI_OMNI_VIDEO=1
# GEMINI_OMNI_MODEL=gemini-omni-1.1-flash
ELEVENLABS_TTS_MODEL=eleven_v3

# --- Yerel GPU ---
COMFYUI_URL=http://127.0.0.1:8188

# --- Claude ajanları (boşsa Claude Code girişi / Max aboneliği kullanılır) ---
# ANTHROPIC_API_KEY=
YS_MODEL_CREATIVE=claude-opus-5-5
YS_MODEL_FAST=claude-sonnet-5-5
YS_MODEL_CHEAP=claude-haiku-5-5

# --- Gemini structured-agent backend (optional) ---
# YS_AGENT_BACKEND=gemini
# GEMINI_AGENT_MODEL=gemini-4-hydrogen
# Rates are ledger estimates; set to 0 when your account is actually on a free tier.
# GEMINI_AGENT_INPUT_USD_PER_MILLION=1.5
# GEMINI_AGENT_OUTPUT_USD_PER_MILLION=7.5

# --- Ajan arka ucu: Claude yerine OpenCode (abonelik) ---
# YS_AGENT_BACKEND=opencode
# YS_OPENCODE_BIN=opencode
# YS_OPENCODE_CREATIVE=opencode-go/deepseek-v4-pro
# YS_OPENCODE_FAST=opencode-go/deepseek-v4.1-flash
# YS_OPENCODE_CHEAP=opencode-go/minimax-m3.1-flash
# YS_OPENCODE_VISION=nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Yerel TTS: VoiceStudio (k2-fsa/OmniVoice) ---
# YS_VOICESTUDIO_URL=http://127.0.0.1:3900
# YS_VOICESTUDIO_PROFILE=

# --- Experiential ağ geçidi (OpenAI uyumlu): abonelik kotası dolunca LLM çağrıları buradan geçer ---
# Stüdyo → Modeller → Ajan arka ucu = Experiential ağ geçidi
# EXPLABS_API_KEY=
# EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# EXPLABS_MODEL=gpt-6-luna
# EXPLABS_VISION_MODEL=

# --- Orkestrasyon ---
# budget: cheap multimodal agent, no premium image route, one QA frame per scene,
# and a lower default episode cap. Use quality or unset for the original routing.
YS_COST_PROFILE=budget
YS_DEFAULT_EPISODE_BUDGET_USD=4
# Set to 1 only when a premium image is genuinely needed in budget mode.
GEMINI_ENABLE_PREMIUM_IMAGE=0
# Used only when YS_AGENT_BACKEND=gemini and GEMINI_AGENT_MODEL is not explicitly set.
GEMINI_AGENT_CHEAP_MODEL=gemini-3.8-flash
TRIGGER_PROJECT_REF=
YS_WORK_DIR=.data/episodes
# Render paralel sekme sayısı. Boşsa çekirdeklerin yarısı (en çok 2). Bellek/takas darsa 1'e sabitle:
# iki sekme 300 sn boyunca kare bildirmezse render "render stalled" ile düşer (16 Kas).
# YS_RENDER_CONCURRENCY=1
# YS_PIPELINE_CONCURRENCY=1
